source "https://rubygems.org"

# Use the GitHub Pages gem so your local build matches what GitHub builds.
# This pins Jekyll and all supported plugins to GitHub Pages' versions.
gem "github-pages", group: :jekyll_plugins

# Plugins used by the site (also whitelisted by GitHub Pages).
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows / JRuby compatibility (harmless elsewhere)
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
